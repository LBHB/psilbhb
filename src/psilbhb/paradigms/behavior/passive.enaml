import logging
log = logging.getLogger(__name__)

from enaml.application import deferred_call
from enaml.core.api import Looper
from enaml.widgets.api import Action, Label, ToolBar
from enaml.workbench.api import Extension
from enaml.workbench.core.api import Command

from psi.context.api import (
    ContextGroup, Parameter, Result
)
from psi.controller.api import (
    ContinuousInput, ContinuousOutput, ControllerManifest, WaveformOutput,
    ExperimentAction, ExperimentEvent, ExperimentState, TimedTrigger
)
from psi.experiment.api import StatusItem
from psi.data.plots import (TimeContainer, ChannelPlot, ViewBox)
from psi.data.sinks.api import BinaryStore

from .passive_plugin import PassivePlugin


def get_status(trial, experiment_state):
    # Experiment not running
    if experiment_state == 'paused':
        return 'Experiment paused'
    elif experiment_state == 'initialized':
        return 'Waiting to start'
    elif experiment_state == 'stopped':
        return 'Experiment complete'
    return 'Trial {}'.format(trial)


def check_microphones(workbench, manifest):
    controller = workbench.get_plugin('psi.controller')
    data = workbench.get_plugin('psi.data')
    channels = []
    for engine in controller._engines.values():
        engine_channels = engine.get_channels(mode='analog', direction='input', active=False)
        channels.extend(engine_channels)

    channel_names = [c.name for c in channels if 'microphone' in c.name]
    manifest.input_list = channel_names
    data._refresh_plots()


enamldef PassiveManifest(ControllerManifest): manifest:
    '''
    Defines the core settings that any behavior experiment may require. Does
    not include timeout/reward settings as those are provided by plugins.
    '''
    initialized ::
        deferred_call(check_microphones, workbench, manifest)

    attr input_list = []

    # Number of speaker outputs
    attr N_output = 2

    # Number of input microphones
    #attr N_input = 2
    attr N_input = 0  # svd hack for free-field, where microphone_1 and microphone_2 aren't defined.


    # Template that is formatted to generate the channel name each output is
    # linked to.
    attr output_template = 'hw_ao::speaker_{}'

    factory = lambda: PassivePlugin()

    Extension:
        id = manifest.id + '.status'
        point = 'psi.experiment.status'

        StatusItem:
            label = 'Experiment state'
            Label:
                text << get_status(
                    workbench.get_plugin('psi.controller').trial,
                    workbench.get_plugin('psi.controller').experiment_state,
                )

    Extension:
        id = manifest.id + '.behavior_commands'
        point = 'enaml.workbench.core.commands'
        Command:
            id = 'psi.controller.prepare_trial'
            handler = lambda x: controller.prepare_trial()
        Command:
            id = 'psi.controller.start_trial'
            handler = lambda x: controller.start_trial

    Extension:
        id = manifest.id + '.events'
        point = 'psi.controller.actions'

        ExperimentState:
            name = 'trial'

        ExperimentState:
            name = 'iti'
        ExperimentEvent:
            name = 'iti_duration_elapsed'
        ExperimentEvent:
            name = 'trial_ready'

        ExperimentAction:
            #event = 'engines_configured'
            event = 'engines_started'
            command = 'psi.controller.prepare_trial'

        # This action is mandatory and must be executed before any other
        # commands that require some information from context. By default, an
        # infinite number of cycles are specified.
        ExperimentAction:
            event = 'experiment_initialize'
            command = 'psi.context.initialize'
            kwargs = {'selector': None}

    Extension:
        id = manifest.id + '.data'
        point = 'psi.data.sinks'
        BinaryStore:
            # Make sure we save all the spout contact data
            name = 'initiated_data'
            continuous_inputs << manifest.input_list

    Extension:
        id = 'io'
        point = 'psi.controller.io'

        Looper:
            iterable = range(N_output)

            ContinuousOutput:
                name = f'continuous_output_{loop_item+1}'
                label = f'Continuous Output {loop_item+1}'
                target_name = f'hw_ao::speaker_{loop_item+1}'
                configurable = False

            WaveformOutput:
                name = f'output_{loop_item+1}'
                label = f'Output {loop_item+1}'
                target_name = manifest.output_template.format(loop_item + 1)
                configurable = False

        ContinuousInput:
            name = 'speaker_1_monitor'
            source_name = 'hw_ai::speaker_1_monitor'

        TimedTrigger:
            # This is a hardware-timed trigger that allows us to schedule a
            # trigger to occur at a very precise time (as opposed to Trigger,
            # which is software-timed and accuracy of timing is not
            # guaranteed).
            name = 'sync_trigger'
            target_name = 'hw_do::sync_trigger'

    Extension:
        id = manifest.id + '.items'
        point = 'psi.context.items'

        ContextGroup:
            name = 'trial'
            label = 'Trial'
            Parameter:
                name = 'trial_reps'
                label = 'Number of repeats'
                default = 10
            Parameter:
                name = 'snr'
                label = 'SNR (dB)'
                default = 10
            Parameter:
                name = 'iti_duration'
                label = 'Intertrial interval (s)'
                compact_label = 'ITI'
                default = 0.1
            Parameter:
                name = 'target_delay'
                label = 'Target delay (s)'
                default = 0.5

        ContextGroup:
            name = 'results'
            label = 'Trial results'

            Result:
                name = 'trial_start'
                compact_label = 'T/'
                dtype = 'float64'

    Extension:
        id = manifest.id + '.toolbar'
        point = 'psi.experiment.toolbar'

        ToolBar:
            Action:
                text = 'Pause'
                enabled << controller.experiment_state not in ('initialized', 'stopped')
                checkable = True
                toggled ::
                    if checked:
                        log.info('Requesting pause')
                        controller.request_pause()
                    else:
                        log.info('Requesting resume')
                        controller.request_resume()

    Extension:
        id = 'plots'
        point = 'psi.data.plots'

        TimeContainer:
            name = 'trial_plot_container'
            label = 'Trial timing'
            span = 10

            ViewBox:
                name = 'microphone'
                y_min = -0.05
                y_max = 0.05

                ChannelPlot:
                    source_name = 'microphone_calibration'
                    pen_color = 'pink'

            ViewBox:
                name = 'microphone_2'
                y_min = -0.05
                y_max = 0.05

                ChannelPlot:
                    source_name = 'microphone_2'
                    pen_color = 'green'

            ViewBox:
                y_min = -0.5
                y_max = 5.5

                ChannelPlot:
                    source_name = 'sync_trigger_monitor'
                    pen_color = 'green'
