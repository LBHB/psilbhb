context:
  meta:
    trial_log:
    - this_reference_frequency
    - this_probe_frequency
    - this_level
  parameters:
    AMFusion:
      duration:
        expression: '0.1'
        rove: false
      fs:
        expression: '44000'
        rove: false
      post_silence:
        expression: '0.05'
        rove: false
      pre_silence:
        expression: '0.05'
        rove: false
      primary_channel:
        rove: false
        selected: '0'
      probe_count:
        expression: '9'
        rove: false
      probe_level:
        expression: '[-20,-10,0,10,20]'
        rove: false
      probe_octaves:
        expression: '1'
        rove: false
      random_seed:
        expression: '0'
        rove: false
      reference_center:
        expression: '1000'
        rove: false
      reference_level:
        expression: '50'
        rove: false
      switch_channels:
        rove: false
        selected: 'No'
      this_level: {}
      this_probe_frequency: {}
      this_reference_frequency: {}
    results:
      trial_start: {}
    trial:
      iti_duration:
        expression: '0.1'
        rove: false
      snr:
        expression: '10'
        rove: false
      target_delay:
        expression: '0.5'
        rove: false
  selectors: {}
event_log:
  column_widths:
    event: 100
    info: 100
    timestamp: 100
microphone:
  y_max: 1.0
  y_min: -1.0
trial_log:
  column_config:
    this_level:
      width: 39
    this_probe_frequency:
      width: 39
    this_reference_frequency:
      width: 39
