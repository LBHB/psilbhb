'''
LBHB behavior paradigms on any computer, with keys for the IR sensors.

Stimuli play on the computer's default sound output (set in Windows' Sound
settings), at the sampling rate set for it there. Keys stand in for the IR
sensors:

=====  =======================================  ==========================
Key    Input (hw_ai)                            Stands in for
=====  =======================================  ==========================
Space  np_contact                               Nose-poke
Left   spout_contact_1, reward_contact          Spout 1 (go/nogo reward)
Right  spout_contact_2                          Spout 2
=====  =======================================  ==========================

Hold a key to break the beam. As on the rigs (see weasel.enaml), spout 1 and
the go/nogo reward spout are one sensor under two names. The keys are read as
sampled signals that go high while the key is held, as the rigs' IR inputs
do, so the sensor processing (`ADC`), plots and stored data run as they do on
a rig.

The speaker monitors and microphones are digital loopbacks: the samples sent
to the sound card, not recordings. The sync pulse (`sync_trigger`) is
generated on the keyboard engine's clock and read back as `sync_monitor`.
Water dispensers and the room light are logged (logger
`psi.controller.engines.keyboard`).

Keys are read whichever part of the window has focus, except a field being
typed into. Run psi with `--io` set to this file, e.g.:

    psi psilbhb.paradigms.lbhb.AMF --io <this file>

(The launcher lists it as "keyboard" when PSI_IO_ROOT is this folder.)

The speakers play 120 dB SPL at 1 Vrms, and the microphones read the same,
so levels are nominal but play far quieter than they would on a rig rather
than dangerously loud.
'''
from enaml.workbench.api import Extension, PluginManifest

from psi.controller.api import (ADC, ContinuousInput, SoftwareDOChannel,
                                Toggle, Transform, Trigger)
from psi.controller.engines.keyboard import (
    KeyboardAIChannel, KeyboardDOChannel, KeyboardEngine, LoopbackAIChannel,
)
from psi.controller.engines.soundcard import SoundcardEngine
from psiaudio.calibration import FlatCalibration

from cftscal.io.keyboard import default_output, Speaker


def invert(x):
    return 1 - x


enamldef IRKey(KeyboardAIChannel): irc:
    '''
    Key standing in for an IR sensor. The rigs' IR inputs go high when the
    beam is broken, but a key held reads low, so the signal is inverted before
    the same `ADC` the rigs use.
    '''
    held_level = 0
    unit = 'V'

    Transform:
        name << irc.name + '_inverted'
        function = invert

        ADC:
            name << irc.name
            threshold = 0.75


enamldef Microphone(LoopbackAIChannel):
    supported_devices = ['generic_microphone']
    calibration = FlatCalibration.from_spl(120)
    unit = 'V'


enamldef IOManifest(PluginManifest): manifest:
    '''
    The computer's default sound output plus keys for the IR sensors. See the
    module docstring.
    '''
    id = 'keyboard_io'

    Extension:
        id = 'keyboard'
        point = 'psi.controller.io'

        SoundcardEngine: sound:
            attr output = default_output()
            name = 'sound'
            master_clock = True
            device_name = output[0]
            fs = output[1]
            # Small, so stimuli play soon after a key press.
            blocksize = 512

            Speaker:
                channel = 0
                name = 'speaker_1'
                label = 'Speaker 1 (left)'
            Speaker:
                channel = 1
                name = 'speaker_2'
                label = 'Speaker 2 (right)'

        KeyboardEngine:
            name = 'keyboard'
            clock = sound
            fs = 10000

            IRKey:
                # For go-nogo and NAFC
                name = 'np_contact'
                label = 'Nose-poke IR (Space)'
                key = 'Space'
            IRKey:
                # For go-nogo
                name = 'reward_contact'
                label = 'Reward IR (Left)'
                key = 'Left'
            IRKey:
                # For NAFC
                name = 'spout_contact_1'
                label = 'Spout IR 1 (Left)'
                key = 'Left'
            IRKey:
                # For NAFC
                name = 'spout_contact_2'
                label = 'Spout IR 2 (Right)'
                key = 'Right'

            LoopbackAIChannel:
                name = 'speaker_1_monitor'
                label = 'Speaker 1 monitor (digital)'
                source_name = 'speaker_1'
                unit = 'V'
            LoopbackAIChannel:
                name = 'speaker_2_monitor'
                label = 'Speaker 2 monitor (digital)'
                source_name = 'speaker_2'
                unit = 'V'

            # The microphones are named as on weasel and badger.
            Microphone:
                name = 'microphone_calibration'
                label = 'Microphone 1 (digital loopback of speaker 1)'
                source_name = 'speaker_1'
                ContinuousInput:
                    name = 'microphone'
                ContinuousInput:
                    name = 'microphone_calibration'
            Microphone:
                name = 'microphone_1'
                label = 'Microphone 1 (digital loopback of speaker 1)'
                source_name = 'speaker_1'
                # The passive paradigms store each microphone channel's input
                # of the same name.
                ContinuousInput:
                    name = 'microphone_1'
            Microphone:
                name = 'microphone_2'
                label = 'Microphone 2 (digital loopback of speaker 2)'
                source_name = 'speaker_2'
                ContinuousInput:
                    name = 'microphone_2'

            KeyboardDOChannel:
                name = 'sync_trigger'
                label = 'Sync trigger'
            LoopbackAIChannel:
                name = 'sync_monitor'
                label = 'Sync monitor (digital)'
                source_name = 'sync_trigger'
                unit = 'V'
                ContinuousInput:
                    name = 'sync_trigger_monitor'

            SoftwareDOChannel:
                name = 'water_dispense_1'
                label = 'Water dispenser 1'
                # go/nogo uses water_dispense; NAFC water_dispense_1.
                Trigger:
                    name = 'water_dispense'
                Trigger:
                    name = 'water_dispense_1'
            SoftwareDOChannel:
                name = 'water_dispense_2'
                label = 'Water dispenser 2'
                Trigger:
                    name = 'water_dispense_2'
            SoftwareDOChannel:
                name = 'room_light'
                label = 'Room light'
                Toggle:
                    name = 'room_light_toggle'
                    label = 'Room light'
