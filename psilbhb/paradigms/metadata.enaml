enamldef CellDbMetadata(ExperimentManifest): manifest:

    Extension:
        id = 'psilbhb.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.pre_celldb'
            handler = pre_celldb

        Command:
            id = manifest.id + '.post_celldb'
            handler = post_celldb

    Extension:
        id = 'psilbhb.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.pre_celldb'

        ExperimentAction:
            event = 'experiment_end'
            command = manifest.id + '.post_celldb'

    Extension:
        id = 'psilbhb.metadata'
        point = 'psi.experiment.metadata'

        MetadataItem:
            name = 'PSILBHB_EXPERIMENTER'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'PSILBHB_ANIMAL'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'PSILBHB_SITEID'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'PSILBHB_TRAINING'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'PSILBHB_RUNCLASS'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'PSILBHB_RUNNUMBER'
            value = os.environ.get(self.name, '0')

        MetadataItem:
            name = 'PSILBHB_NOTE'
            value = os.environ.get(self.name, '')

        MetadataItem:
            name = 'PSILBHB_BASE_FOLDER'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'PSILBHB_IO'
            value = os.environ.get(self.name, 'UNKNOWN')

        MetadataItem:
            name = 'DATA_ROOT'
            value = get_config(self.name)

        MetadataItem:
            name = 'OPENEPHYS_ROOT'
            value = get_config(self.name)

        MetadataItem:
            name = 'CACHE_ROOT'
            value = get_config(self.name)

        MetadataItem:
            name = 'TRAINING_ROOT'
            value = get_config(self.name)

        MetadataItem:
            name = 'VIDEO_ROOT'
            value = get_config(self.name)

        MetadataItem:
            name = 'PREFERENCES_ROOT'
            value = get_config(self.name)

        MetadataItem:
            name = 'LAYOUT_ROOT'
            value = get_config(self.name)

        MetadataItem:
