from psilbhb.util.celldb import celldb, readpsievents

def pre_celldb(event):
    """
    Create celldb.gDataRaw entry for this run
    Pull metadata from psi config and env variables set by the psilbhb launcher
    (use PSILBHB prefix)
    """
    workbench = event.workbench
    plugin = workbench.get_plugin('psi.controller')

    ### COPIED/REFACTORED FROM launcher.py

    # Get info from env vars as needed
    training = os.environ.get('PSILBHB_TRAINING', 'Yes')
    siteid = os.environ.get('PSILBHB_SITEID', 'Yes')
    runnumber = int(os.environ.get('PSILBHB_RUNNUMBER', '0'))
    note = int(os.environ.get('PSILBHB_NOTE', ''))

    oeroot = get_config('OPENEPHYS_ROOT')
    #oeroot2 = get_config('OPENEPHYS_ROOT')

    # TODO : figure out how to reach current WavSet instance
    # runclass = current_wav_set.runclass

    if training == 'Yes':
        behavior = 'active'
        ephys = False
        dataroot = get_config('DATA_ROOT')
        #dataroot = get_config('TRAINING_ROOT')
    elif training == 'Physiology+behavior':
        behavior = 'active'
        ephys = True
        dataroot = get_config('DATA_ROOT')
    else:
        behavior = 'passive'
        ephys = True
        dataroot = get_config('DATA_ROOT')

    db = celldb()
    rawdata = db.create_rawfile(
        siteid=siteid, runclass=runclass, filenum=runnumber,
        behavior=behavior, note=note, pupil=True, psi_format=True,
        dataroot=dataroot, rawroot=oeroot)
    log.info('Created raw data entry')


