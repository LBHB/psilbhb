'''
This file defines how experiments for LBHB communicate with OpenEphys. The
plugin itself is psiopenephys's `OpenEphysManifest`; only what is specific to
LBHB is here:

* When an experiment starts, OpenEphys records to the experiment's data
  folder moved from drive e: to d:, under raw/<date and time>.
* Every trial_start and trial_end is sent to OpenEphys as a message
  containing the timestamp and event name (e.g., "0.321 trial_start").

The server is the PSIOPENEPHYS_URI setting.
'''
import datetime as dt
from pathlib import Path

from enaml.workbench.api import Extension

from psiopenephys.manifest import OpenEphysManifest
from psiopenephys.plugin import OpenEphysTarget, TARGET_POINT


enamldef LBHBOpenEphysManifest(OpenEphysManifest): manifest:

    message_events = ['trial_start', 'trial_end']
    default_target = False

    Extension:
        id = manifest.id + '.lbhb_target'
        point = TARGET_POINT
        OpenEphysTarget:
            name = 'lbhb'
            recording_path => (base_path):
                # TODO: set record node for second NP probe to use
                # PSILBHB_OPENEPHYS_ROOT2
                dt_str = dt.datetime.now().strftime('%Y-%m-%d_%H_%M_%S')
                return Path(str(base_path).replace('e:', 'd:')) / 'raw' / dt_str
