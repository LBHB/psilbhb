from enaml.workbench.api import Extension
from enaml.workbench.core.api import Command

from cftscal.objects import starship_manager
from psi.controller.engines.nidaq import (connect_trigger,
                                          NIDAQEngine,
                                          NIDAQHardwareAIChannel,
                                          NIDAQHardwareAOChannel,
                                          NIDAQHardwareDOChannel,
                                          NIDAQSoftwareDOChannel,
                                          )

from psi.core.enaml.api import ExperimentManifest
from psi.controller.api import (ADC, ContinuousOutput, ContinuousInput,
    ExperimentAction)

from psiaudio.calibration import FlatCalibration


# Requested sampling rate must be an integer divisor of the timebase clock.
ao_fs = 20e6 / 454
ai_fs = 20e6 / 454


from psi.controller.api import Trigger, Toggle


START_TRIGGER = '/PXI1Slot3/ao/StartTrigger'


def configure_channels(event):
    # Ensure that the start trigger is set properly given the hardware channel
    # configuration.
    connect_trigger(event)


enamldef IRChannel(NIDAQHardwareAIChannel): irc:

    unit = 'V'
    start_trigger = START_TRIGGER
    fs = ai_fs
    expected_range = (-10, 10)
    dtype = 'float64'
    terminal_mode = 'RSE'
    reference_clock = 'PXI_Clk10'

    ADC: adc:
        name << irc.name
        threshold = 0.75


enamldef IOManifest(ExperimentManifest): manifest:

    Extension:
        id = 'ornitorinco_commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = 'weasel.configure_channels'
            handler = configure_channels

    Extension:
        id = 'ornitorinco_actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'experiment_prepare'
            command = 'weasel.configure_channels'
            weight = 90

    Extension:
        id = 'backend'
        point = 'psi.controller.io'

        NIDAQEngine:
            name = 'NI'
            hw_ai_monitor_period = 0.1
            hw_ao_monitor_period = 0.1
            hw_ao_buffer_size = 2

            NIDAQHardwareAIChannel:
                label = 'Speaker 1 monitor'
                name = 'speaker_1_monitor'
                channel = '/Dev1/ai3'
                start_trigger = START_TRIGGER
                fs = ai_fs
                expected_range = (-10, 10)
                dtype = 'float64'
                terminal_mode = 'differential'
                unit = 'V'
                calibration_user_editable = True
                reference_clock = 'PXI_Clk10'

            NIDAQHardwareAIChannel:
                label = 'Sync Monitor'
                name = 'sync_monitor'
                channel = 'Dev1/ai4'
                start_trigger = '/Dev1/ao/StartTrigger'
                fs = ai_fs
                expected_range = (-10, 10)
                dtype = 'float64'
                terminal_mode = 'RSE'
                unit = 'V'
                calibration = FlatCalibration.from_mv_pa(2.38)
                reference_clock = 'PXI_Clk10'

            NIDAQHardwareDOChannel:
                label = 'Sync Trigger'
                name = 'sync_trigger'
                channel = '/Dev1/port0/line3'
                sample_clock = '/PXI1Slot3/ao/SampleClock'
                fs = ao_fs

            NIDAQSoftwareDOChannel:
                name = 'water_dispense_1'
                channel = 'Dev1/port0/line0'

                # You can have multiple triggers connected to a single
                # software-timed digital output. The behavior programs will
                # only use one of these triggers. For the NAFC, it will look
                # for the `water_dispense_1` and `water_dispense_2` triggers.
                # For the go-nogo, it will look for the `water_dispense`
                # trigger. By providing both triggers, we can make sure that
                # each program continues to work properly.
                Trigger:
                    name = 'water_dispense'

                Trigger:
                    name = 'water_dispense_1'

            NIDAQSoftwareDOChannel:
                name = 'water_dispense_2'
                channel = 'Dev1/port0/line2'

                # This is for the second lick spout added to support the 2AFC
                # experiment (I call it NAFC and will be writing it so it can
                # support an arbitrary number of alternate forced choices).
                Trigger:
                    name = 'water_dispense_2'

            NIDAQSoftwareDOChannel:
                name = 'room_light'
                channel = 'Dev1/port0/line1'

                Toggle:
                    # This is a required output for the room light. The plugin
                    # will look for this output by name. If not present, the
                    # room light plugin will not work!
                    name = 'room_light_toggle'
                    label = 'Room light'

            # We make the same input channel available under two names,
            # reward_contact and spout_contact_1, so that we can easily switch
            # between the go-nogo and NAFC experiments. Well, easily from a
            # software perspective. You still will need to go into the chamber
            # and remove the second lick spout so the ferret doesn't try to use
            # it.
            IRChannel:
                # For go-nogo
                name = 'reward_contact'
                label = 'Reward IR'
                channel = 'Dev1/ai0'

            IRChannel:
                # For go-nogo and NAFC
                name = 'np_contact'
                label = 'Nose-poke IR'
                channel = 'Dev1/ai1'

            IRChannel:
                # for NAFC
                name = 'spout_contact_1'
                label = 'Spout IR 1'
                channel = 'Dev1/ai0'

            IRChannel:
                # for NAFC
                name = 'spout_contact_2'
                label = 'Spout IR 2'
                channel = 'Dev1/ai2'

        NIDAQEngine:
            name = 'NI_audio'
            hw_ai_monitor_period = 0.1
            hw_ao_monitor_period = 0.1
            hw_ao_buffer_size = 2

            ###############################################
            # Starship A
            ###############################################
            NIDAQHardwareAOChannel:
                label = 'Starship 1 (primary)'
                name = 'speaker_1'
                channel = '/PXI1Slot3/ao0'
                fs = ao_fs
                expected_range = (-10, 10)
                dtype = 'float64'
                terminal_mode = 'differential'
                unit = 'V'
                reference_clock = 'PXI_Clk10'

            NIDAQHardwareAIChannel:
                label = 'Starship 1 (microphone)'
                name = 'microphone_1'
                channel = '/PXI1Slot3/ai0'
                fs = ao_fs
                expected_range = (-10, 10)
                dtype = 'float64'
                terminal_mode = 'differential'
                unit = 'V'
                start_trigger = '/Dev1/ao/StartTrigger'
                reference_clock = 'PXI_Clk10'
                gain = 40
                calibration = starship_manager \
                    .get_object('LBHB1') \
                    .get_current_calibration() \
                    .load()

            ###############################################
            # Starship B
            ###############################################
            NIDAQHardwareAOChannel:
                label = 'Starship 2 (primary)'
                name = 'speaker_2'
                channel = '/PXI1Slot3/ao1'
                fs = ao_fs
                expected_range = (-10, 10)
                dtype = 'float64'
                terminal_mode = 'differential'
                unit = 'V'
                reference_clock = 'PXI_Clk10'

            NIDAQHardwareAIChannel:
                label = 'Starship 2 (microphone)'
                name = 'microphone_2'
                channel = '/PXI1Slot3/ai1'
                fs = ao_fs
                expected_range = (-10, 10)
                dtype = 'float64'
                terminal_mode = 'differential'
                unit = 'V'
                start_trigger = '/Dev1/ao/StartTrigger'
                reference_clock = 'PXI_Clk10'
                gain = 40
                calibration = starship_manager \
                    .get_object('LBHB2') \
                    .get_current_calibration() \
                    .load()
